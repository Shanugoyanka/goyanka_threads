generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Product Catalogue ──

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   // e.g. "bridal-veil"
  styleTags   Json     // e.g. ["minimal","elegant"]
  colours     Json     // e.g. ["red","mehroon","rani-pink"]
  veilLength  String   // e.g. "84" or "120" (inches)
  fabric      String   // e.g. "Net", "Tulle", "Organza"
  embroidery  String   // embellishment details text
  basePrice   Int      // price in INR (whole rupees)
  minPrice    Int?     // minimum if customization changes price
  maxPrice    Int?     // maximum if customization changes price
  customizationOptions Json // e.g. ["initials","name","date","custom"]
  status      String   @default("available") // available | made-to-order | discontinued
  imageUrls   Json     // array of image URL strings
  videoUrls   Json     @default("[]") // array of video URL strings
  customerMediaUrls Json @default("[]") // array of {url,type,approved}
  deliveryDays     Int     @default(21) // estimated production + delivery days
  isFeatured  Boolean  @default(false)
  isSample    Boolean  @default(true) // true = sample/placeholder data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiryProducts EnquiryProduct[]
}

// ── Customer Enquiry ──

model Enquiry {
  id                 String    @id @default(cuid())
  enquiryNumber      String    @unique // human-readable: GT-1001
  status             String    @default("NEW") // NEW | CONTACTED | IN_DISCUSSION | PAYMENT_PENDING | ORDERED | CLOSED
  customerName       String
  whatsappNumber     String
  weddingDate        String?
  weddingDateNotFixed Boolean  @default(false)
  city               String?
  pincode            String?
  outfitColour       String?
  customOutfitColour String?
  preferredStyle     String?   // "minimal" | "heavy" | "personalized" | "not-sure"
  budgetMin          Int?
  budgetMax          Int?
  personalization    String?   // "none" | "names" | "date" | "names-date" | "custom-text" | "not-sure"
  source             String?   // e.g. "instagram", "whatsapp", "direct"
  campaign           String?   // e.g. "maroon-heavy-reel"
  assignedTo         String?
  internalNotes      String?
  notes              String?
  submittedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  firstOpenedAt      DateTime?
  contactedAt        DateTime?
  convertedAt        DateTime?

  selectedProducts EnquiryProduct[]
}

// ── Junction: Enquiry ↔ Product ──

model EnquiryProduct {
  id        String  @id @default(cuid())
  enquiryId String
  productId String

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
}

// ── Order (from finalised Google Form) ──

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // GT-O-1001
  status          String   @default("NEW") // NEW | IN_PRODUCTION | DISPATCHED | DELIVERED | CLOSED

  // Customer details
  customerName    String
  whatsappNumber  String
  shippingAddress String

  // Veil specifications
  veilWidth       String
  veilColour      String
  veilLength      String
  blusher         String?  // "detachable" | "attached" | null
  veilShape       String   // "round" | "scalloped" | "straight" | "other"
  veilShapeOther  String?

  // Stone details
  stonePlacement      String?  // "throughout" | "border-only" | "heavy-crown" | "scattered" | "other"
  stonePlacementOther String?
  stoneDensity        String?  // "100" | "200" | "200+" | "other"
  stoneDensityOther   String?
  stoneColor          String?  // "gold" | "silver" | "no-stone"

  // Border
  borderDetails       String
  referenceImageUrl   String?

  // Customisation
  customisation           String   // "name" | "couples-name" | "wedding-date" | "initials" | "logo" | "custom-text" | "none"
  customisationText       String?
  customisationSize       String?
  customisationPlacement  String?
  additionalInstructions  String?
  customisationRefImageUrl String?

  // Dates
  weddingDate    String
  dispatchDate   String?

  // Payment
  paymentScreenshotUrl String?

  // Admin fields
  assignedTo     String?
  internalNotes  String?
  source         String?
  campaign       String?

  // Timestamps
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  firstOpenedAt  DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
}
